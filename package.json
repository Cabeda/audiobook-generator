{
  "name": "audiobook-generator-web",
  "version": "0.31.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:nightly": "playwright test --config=playwright.nightly.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "build:epub": "pandoc --metadata-file=books/short-epub/metadata.yaml --toc -o books/test-short.epub books/short-epub/01-chapter-1.md books/short-epub/02-chapter-2.md books/short-epub/03-chapter-3.md",
    "test:e2e:fast": "pnpm run build:epub && playwright test -g \"SHORT EPUB\" --project=chromium --reporter=list --workers=1 --enable-unsafe-webgpu"
  },
  "lint-staged": {
    "*.{ts,tsx,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/html-to-text": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@typescript/native-preview": "7.0.0-dev.20260521.1",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.55.9",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@mediabunny/aac-encoder": "^1.45.3",
    "@mediabunny/mp3-encoder": "^1.45.3",
    "@mozilla/readability": "^0.6.0",
    "epubjs": "^0.3.93",
    "franc-min": "^6.2.0",
    "html-to-text": "^10.0.0",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "mediabunny": "^1.45.3",
    "onnxruntime-web": "^1.26.0",
    "pdfjs-dist": "^5.7.284",
    "phonemizer": "^1.2.1",
    "workbox-window": "^7.4.1"
  }
}
