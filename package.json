{
  "name": "audiobook-generator-web",
  "version": "0.32.4",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:nightly": "playwright test --config=playwright.nightly.config.ts",
    "test:e2e:profile": "playwright test --config=playwright.profile.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:benchmark": "playwright test --config=playwright.benchmark.config.ts",
    "benchmark:book": "node scripts/benchmark-book.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "type-check": "tsgo --noEmit && svelte-check --threshold error",
    "prepare": "husky",
    "build:epub": "pandoc --metadata-file=books/short-epub/metadata.yaml --toc -o books/test-short.epub books/short-epub/01-chapter-1.md books/short-epub/02-chapter-2.md books/short-epub/03-chapter-3.md",
    "test:e2e:fast": "pnpm run build:epub && playwright test -g \"SHORT EPUB\" --project=chromium --reporter=list --workers=1 --enable-unsafe-webgpu"
  },
  "lint-staged": {
    "*.{ts,tsx,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/html-to-text": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@mediabunny/aac-encoder": "^1.61.6",
    "@mediabunny/mp3-encoder": "^1.61.6",
    "@mozilla/readability": "^0.6.0",
    "epubjs": "^0.3.93",
    "franc-min": "^6.2.0",
    "html-to-text": "^10.0.1",
    "jszip": "^3.10.2",
    "kokoro-js": "^1.2.1",
    "mediabunny": "^1.61.6",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^6.4.299",
    "phonemizer": "^1.2.1",
    "workbox-window": "^7.4.1"
  }
}
